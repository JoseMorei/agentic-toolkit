# Copy this file to .env and fill in your own keys.
# .env stays on your computer: it is listed in .gitignore and is never uploaded.
# Leave a line empty if you don't use that tool; the other connectors keep working.

# PagerDuty: a User API key (Profile → User Settings → Create API User Token)
PAGERDUTY_API_KEY=
# Optional: use https://mcp.eu.pagerduty.com/mcp if your account is in PagerDuty's EU region
# PAGERDUTY_MCP_URL=https://mcp.pagerduty.com/mcp

# GitHub: a fine-grained personal access token with read-only permissions
GITHUB_PERSONAL_ACCESS_TOKEN=

# env0: an API key + secret, and your organization ID (Organization Settings → General)
ENV0_API_KEY=
ENV0_API_SECRET=
ENV0_ORGANIZATION_ID=

# IBM Cloud: an API key with viewer access to VPC
IBMCLOUD_API_KEY=
